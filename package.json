{
  "name": "svelte-meteo-fly",
  "version": "0.0.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project src/service-worker/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "svelte-kit sync && npm run test:unit -- --run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.59.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/eslint": "^9.6.1",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "maplibre-gl": "^6.15.0",
    "openmeteo": "^1.2.3",
    "paneforge": "^1.0.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "overrides": {
    "runed": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
